      "saved": "Caller",
      "was": "Source index"
    },
    {
      "reg": "rdi",
      "role": "First argument",
      "saved": "Caller",
      "was": "Destination index"
    },
    {
      "reg": "rbp",
      "role": "Frame pointer, or general if omitted",
      "saved": "Callee",
      "was": "Base pointer"
    },
    {
      "reg": "rsp",
      "role": "Stack pointer, used by the hardware",
      "saved": "Callee",
      "was": "Stack pointer",
      "detail": {
        "summary": "The one register the processor itself reads and writes."
