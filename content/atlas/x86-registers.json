      "key": "reg",
      "label": "Register",
      "mono": true
    },
    {
      "key": "role",
      "label": "Convention"
    },
    {
      "key": "saved",
      "label": "Saved by"
    },
    {
      "key": "was",
      "label": "Originally"
    }
  ],
  "rows": [
    {
      "reg": "rax",
      "role": "Return value; syscall number",
      "saved": "Caller",
      "was": "Accumulator"
    },
    {
